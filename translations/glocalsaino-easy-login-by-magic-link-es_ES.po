#. Plugin Name of the plugin
#: glocalsaino-easy-login-by-magic-link.php
msgid "GlocalSaino Easy Login by Magic Link"
msgstr "GlocalSaino Easy Login by Magic Link"

#. Plugin URI of the plugin
#: glocalsaino-easy-login-by-magic-link.php
msgid "https://glocalsaino.com/easyloginbymagiclink/"
msgstr "https://glocalsaino.com/easyloginbymagiclink/"

#. Description of the plugin
#: glocalsaino-easy-login-by-magic-link.php
msgid "Create secure magic links that log a WordPress user in with one click, no password needed. Set expiry, maximum uses and a redirect URL for each link."
msgstr "Crea enlaces mágicos seguros que inician sesión en WordPress como un usuario con un solo clic, sin contraseña. Configura caducidad, usos máximos y URL de destino por enlace."

#. Author of the plugin
#: glocalsaino-easy-login-by-magic-link.php
msgid "Glocal Saino"
msgstr "Glocal Saino"

#. Author URI of the plugin
#: glocalsaino-easy-login-by-magic-link.php
msgid "https://glocalsaino.com/"
msgstr "https://glocalsaino.com/"

#: includes/class-gselml-admin.php:45
#: includes/class-gselml-admin.php:125
msgid "Easy Login by Magic Link"
msgstr "Acceso fácil con enlace mágico"

#: includes/class-gselml-admin.php:46
msgid "Easy Login"
msgstr "Acceso fácil"

#: includes/class-gselml-admin.php:64
msgid "Settings"
msgstr "Ajustes"

#: includes/class-gselml-admin.php:95
msgid "Copied"
msgstr "Copiado"

#: includes/class-gselml-admin.php:96
msgid "Revoke this link? It will stop working immediately."
msgstr "¿Revocar este enlace? Dejará de funcionar inmediatamente."

#: includes/class-gselml-admin.php:116
msgid "Magic link created. Copy it from the list below."
msgstr "Enlace mágico creado. Cópialo de la lista inferior."

#: includes/class-gselml-admin.php:117
msgid "Magic link revoked."
msgstr "Enlace mágico revocado."

#: includes/class-gselml-admin.php:118
msgid "The selected user does not exist."
msgstr "El usuario seleccionado no existe."

#: includes/class-gselml-admin.php:119
msgid "The redirect URL must point to this site."
msgstr "La URL de redirección debe apuntar a este sitio."

#: includes/class-gselml-admin.php:126
msgid "Create links that log a WordPress user in with one click, without a password. Each link holds a random 256-bit token; it never contains or reveals the user's credentials."
msgstr "Crea enlaces que inician sesión en WordPress como un usuario con un solo clic, sin contraseña. Cada enlace lleva un token aleatorio de 256 bits; nunca contiene ni revela las credenciales del usuario."

#: includes/class-gselml-admin.php:133
msgid "Create a link"
msgstr "Crear enlace"

