msgid "User"
msgstr "Usuario"

#: includes/class-gselml-admin.php:146
msgid "A link for an administrator gives full access to the dashboard: share it with care."
msgstr "Un enlace para un administrador da acceso completo al escritorio: compártelo con cuidado."

#: includes/class-gselml-admin.php:150
msgid "Label (optional)"
msgstr "Etiqueta (opcional)"

#: includes/class-gselml-admin.php:152
msgid "e.g. Support access, May"
msgstr "Ej. Acceso soporte mayo"

