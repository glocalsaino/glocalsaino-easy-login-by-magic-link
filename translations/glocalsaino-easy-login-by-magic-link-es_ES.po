#. Plugin Name of the plugin
#: glocalsaino-easy-login-by-magic-link.php
msgid "GlocalSaino Easy Login by Magic Link"
msgstr "GlocalSaino Easy Login by Magic Link"

#. Plugin URI of the plugin
#: glocalsaino-easy-login-by-magic-link.php
msgid "https://glocalsaino.com/easyloginbymagiclink/"
msgstr "https://glocalsaino.com/easyloginbymagiclink/"

#. Description of the plugin
#: glocalsaino-easy-login-by-magic-link.php
msgid "Passwordless login links that only work where they should: lock them to an IP address or a browser, let users request them by email or at registration, and send each role to its own page."
msgstr "Enlaces de acceso sin contraseña que solo funcionan donde deben: limítalos a una IP o a un navegador, deja que los usuarios los pidan por email o al registrarse y envía cada rol a su propia página."

#. Author of the plugin
#: glocalsaino-easy-login-by-magic-link.php
msgid "Glocal Saino"
msgstr "Glocal Saino"

#. Author URI of the plugin
#: glocalsaino-easy-login-by-magic-link.php
msgid "https://glocalsaino.com/"
msgstr "https://glocalsaino.com/"

