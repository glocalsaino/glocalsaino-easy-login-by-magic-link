#: includes/class-gselml-core.php:586
msgid "Log in"
msgstr "Iniciar sesión"

#. translators: %s: user display name.
#: includes/class-gselml-core.php:591
#, php-format
msgid "Log in as %s by clicking the button below."
msgstr "Inicia sesión como %s pulsando el botón de abajo."

#: includes/class-gselml-core.php:607
msgid "Login link not valid"
msgstr "Enlace de acceso no válido"

#: includes/class-gselml-core.php:610
msgid "This login link has expired, has already been used or has been revoked. Request a new one or ask the site administrator."
msgstr "Este enlace de acceso ha caducado, ya se ha usado o se ha revocado. Pide uno nuevo o consulta al administrador del sitio."

#: includes/class-gselml-core.php:611 includes/class-gselml-core.php:630
msgid "Go to the login page"
msgstr "Ir a la página de acceso"

#: includes/class-gselml-core.php:622
msgid "Login link not valid here"
msgstr "Enlace de acceso no válido aquí"

#: includes/class-gselml-core.php:625
msgid "This login link is restricted to certain internet connections (IP addresses), and it cannot be used from the one you are using now."
msgstr "Este enlace de acceso está limitado a ciertas conexiones a internet (direcciones IP) y no se puede usar desde la que estás usando ahora."

#: includes/class-gselml-core.php:626
msgid "This login link only works in the browser where it was requested or first used. Open it in that browser, or request a new link from this one."
msgstr "Este enlace de acceso solo funciona en el navegador donde se pidió o se usó por primera vez. Ábrelo en ese navegador o pide un enlace nuevo desde este."

#: includes/class-gselml-core.php:640 includes/class-gselml-core.php:709
msgid "You are not allowed to do this."
msgstr "No tienes permisos para realizar esta acción."

#: includes/class-gselml-requests.php:80
msgid "You are already logged in."
msgstr "Ya has iniciado sesión."

#: includes/class-gselml-requests.php:87
msgid "If an account exists for this email address, you will receive a link to log in shortly. Check your inbox and spam folder."
msgstr "Si existe una cuenta con este email, en breve recibirás un enlace para iniciar sesión. Revisa tu bandeja de entrada y la carpeta de spam."

#: includes/class-gselml-requests.php:88
msgid "Too many requests. Please wait a while before trying again."
msgstr "Demasiadas solicitudes. Espera un rato antes de volver a intentarlo."

#: includes/class-gselml-requests.php:89
msgid "Please enter a valid email address."
msgstr "Introduce una dirección de email válida."

#: includes/class-gselml-requests.php:90
msgid "The form has expired. Please reload the page and try again."
msgstr "El formulario ha caducado. Recarga la página y vuelve a intentarlo."

#: includes/class-gselml-requests.php:104
msgid "Email address"
msgstr "Dirección de email"

#: includes/class-gselml-requests.php:108
msgid "Leave this field empty"
msgstr "Deja este campo vacío"

#: includes/class-gselml-requests.php:113
msgid "Email me a login link"
msgstr "Envíame un enlace de acceso"

#: includes/class-gselml-requests.php:169
msgid "Requested by email"
msgstr "Solicitado por email"

#. translators: %s: site title.
#: includes/class-gselml-requests.php:234
#, php-format
msgid "[%s] Your login link"
msgstr "[%s] Tu enlace de acceso"

#. translators: %s: user display name.
#: includes/class-gselml-requests.php:237
#, php-format
msgid "Hi %s,"
msgstr "Hola, %s:"

#. translators: %s: site title.
#: includes/class-gselml-requests.php:239
#, php-format
msgid "Use this link to log in to %s:"
msgstr "Usa este enlace para iniciar sesión en %s:"

#. translators: %s: time span such as "15 minutes" or "1 day".
#: includes/class-gselml-requests.php:242
#: includes/class-gselml-requests.php:375
#, php-format
msgid "The link works once and expires in %s."
msgstr "El enlace funciona una sola vez y caduca en %s."

#: includes/class-gselml-requests.php:244
msgid "Open it in the same browser where you requested it."
msgstr "Ábrelo en el mismo navegador desde el que lo pediste."

#: includes/class-gselml-requests.php:246
msgid "If you did not ask for this link, you can safely ignore this email."
msgstr "Si no has pedido este enlace, puedes ignorar este email."

#: includes/class-gselml-requests.php:308
msgid "Also email me a magic link to log in without a password"
msgstr "Envíame también un enlace mágico para entrar sin contraseña"

#: includes/class-gselml-requests.php:341
msgid "Registration"
msgstr "Registro"

#: includes/class-gselml-requests.php:372
msgid "Or log in right away, without a password, with this link:"
msgstr "O entra ahora mismo, sin contraseña, con este enlace:"

#: includes/class-gselml-requests.php:377
msgid "Open it in the same browser where you registered."
msgstr "Ábrelo en el mismo navegador desde el que te registraste."

#: includes/class-gselml-settings.php:85 includes/class-gselml-settings.php:164
msgid "Easy Login settings"
msgstr "Ajustes de Acceso fácil"

#. translators: %s: role name.
#: includes/class-gselml-settings.php:141
#, php-format
msgid "The redirect for the role \"%s\" was ignored: it must point to this site."
msgstr "Se ha ignorado la redirección del rol «%s»: debe apuntar a este sitio."

#: includes/class-gselml-settings.php:171
msgid "Login link request form"
msgstr "Formulario de solicitud de enlace"

#: includes/class-gselml-settings.php:173
msgid "Add this shortcode to any page to show a form where users enter their email address and receive a login link:"
msgstr "Añade este shortcode a cualquier página para mostrar un formulario en el que los usuarios escriben su email y reciben un enlace de acceso:"

#. translators: %s: example shortcode with the redirect attribute.
#: includes/class-gselml-settings.php:180
#, php-format
msgid "Optional: choose the landing page with %s. The answer is always the same, whether the address belongs to an account or not, so the form does not reveal who is registered."
msgstr "Opcional: elige la página de destino con %s. La respuesta es siempre la misma, exista o no una cuenta con ese email, así que el formulario no revela quién está registrado."

#: includes/class-gselml-settings.php:187
#: includes/class-gselml-settings.php:243
msgid "Link expires after"
msgstr "El enlace caduca tras"

#: includes/class-gselml-settings.php:190
msgid "Links sent by email always work only once."
msgstr "Los enlaces enviados por email funcionan siempre una sola vez."

#: includes/class-gselml-settings.php:194
msgid "Rate limits"
msgstr "Límite de solicitudes"

#. translators: %s: number input.
#: includes/class-gselml-settings.php:200
#, php-format
msgid "At most %s requests per email address per hour"
msgstr "Como máximo %s solicitudes por email y hora"

#. translators: %s: number input.
#: includes/class-gselml-settings.php:209
#, php-format
msgid "At most %s requests per IP address per hour"
msgstr "Como máximo %s solicitudes por dirección IP y hora"

#: includes/class-gselml-settings.php:220
msgid "Registration form"
msgstr "Formulario de registro"

#. translators: %s: link to Settings → General.
#: includes/class-gselml-settings.php:226
#, php-format
msgid "User registration is currently turned off in %s, so the checkbox will not be visible."
msgstr "El registro de usuarios está desactivado en %s, así que la casilla no se verá."

#: includes/class-gselml-settings.php:227
msgid "Settings → General"
msgstr "Ajustes → Generales"

#: includes/class-gselml-settings.php:234
msgid "Checkbox"
msgstr "Casilla"

#: includes/class-gselml-settings.php:238
msgid "Add a checkbox to the WordPress registration form so new users can get a magic link in their welcome email"
msgstr "Añadir una casilla al formulario de registro de WordPress para que los nuevos usuarios reciban un enlace mágico en su email de bienvenida"

#: includes/class-gselml-settings.php:250
msgid "Security of emailed links"
msgstr "Seguridad de los enlaces enviados por email"

#: includes/class-gselml-settings.php:251
msgid "These options apply to links sent by the request form and by the registration checkbox."
msgstr "Estas opciones se aplican a los enlaces enviados desde el formulario de solicitud y desde la casilla de registro."

#: includes/class-gselml-settings.php:258
msgid "Show a page with a \"Log in\" button so email scanners cannot use up the link (recommended)"
msgstr "Mostrar una página con el botón «Iniciar sesión» para que los escáneres de correo no gasten el enlace (recomendado)"

#: includes/class-gselml-settings.php:263
msgid "Same-browser protection"
msgstr "Protección de mismo navegador"

#: includes/class-gselml-settings.php:267
msgid "The link only works in the browser where it was requested"
msgstr "El enlace solo funciona en el navegador desde el que se pidió"

#: includes/class-gselml-settings.php:269
msgid "A copied, forwarded or intercepted link is useless on any other device. Users must open the email on the same device and in the same browser; links opened inside an email app's own browser may not work."
msgstr "Un enlace copiado, reenviado o interceptado no sirve en ningún otro dispositivo. Los usuarios deben abrir el email en el mismo dispositivo y el mismo navegador; los enlaces abiertos en el navegador interno de una app de correo pueden no funcionar."

#: includes/class-gselml-settings.php:273
msgid "Roles that cannot get links by email"
msgstr "Roles que no pueden recibir enlaces por email"

#: includes/class-gselml-settings.php:283
msgid "Users with these roles get no email from the request form (the form still shows the usual message). Administrators can still create links for them manually."
msgstr "Los usuarios con estos roles no reciben ningún email desde el formulario (que sigue mostrando el mensaje habitual). Los administradores pueden seguir creándoles enlaces a mano."

#: includes/class-gselml-settings.php:290
msgid "Redirect after login, by role"
msgstr "Redirección tras el acceso, por rol"

#: includes/class-gselml-settings.php:291
msgid "Page each role lands on after logging in with a magic link. A page set on the link itself (or in the shortcode) takes priority. Empty: the home page."
msgstr "Página a la que llega cada rol tras entrar con un enlace mágico. Tiene prioridad la página indicada en el propio enlace (o en el shortcode). Vacío: la página de inicio."
